# Project Settings
PROJECT_NAME="Imgre Multi-Agent Automation"
API_V1_STR="/api/v1"
DEBUG=true

# Database Connection
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/imgre_db"

# Gemini & Imagen Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
DEFAULT_GEMINI_MODEL="models/gemini-3.5-flash"
IMAGEN_MODEL="imagen-3.0-generate-002"
IMAGE_GEN_RESOLUTION="1024x1024"

# Scheduler Configuration (Default: 09:00 AM daily)
SCHEDULER_CRON_HOUR=9
SCHEDULER_CRON_MINUTE=0
